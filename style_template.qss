/* PDA Widget stylesheet template — colors filled in by ui/theme.py */

#PDAPanel {
    background-color: $bg;
    border: 1px solid $border;
    border-radius: 4px;
}

#PDAPanel[mode="pill"] {
    border-radius: 20px;
}

QLabel {
    color: $text;
    font-family: "Consolas", "Cascadia Mono", monospace;
    background: transparent;
}

QLabel#HeaderLabel {
    color: $header;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#ClockLabel {
    color: $text_bright;
    font-size: 26px;
    font-weight: bold;
}

QLabel#DateLabel {
    color: $date;
    font-size: 11px;
}

QLabel#SectionLabel {
    color: $text_dim;
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 6px;
}

QLabel#StatLabel {
    color: $text;
    font-size: 12px;
}

QLabel#PillLabel {
    color: $text;
    font-size: 12px;
    font-weight: bold;
}

QProgressBar {
    background-color: $bar_bg;
    border: 1px solid $bar_border;
    border-radius: 2px;
    text-align: center;
    color: $text_bright;
    font-size: 10px;
    height: 14px;
}

QProgressBar::chunk {
    background-color: $bar_chunk;
    border-radius: 1px;
}

/* Header icon buttons (mode toggle, lock, theme) — fixed square,
   text centered, no padding eating into the click target. */
QPushButton#IconButton {
    color: $text_dim;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    font-size: 13px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

QPushButton#IconButton:hover {
    color: $header;
    border: 1px solid $border;
}

QPushButton#CloseButton {
    color: $text_dim;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    font-size: 15px;
    font-weight: bold;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

QPushButton#CloseButton:hover {
    color: #e05a5a;
    border: 1px solid rgba(224, 90, 90, 120);
}
